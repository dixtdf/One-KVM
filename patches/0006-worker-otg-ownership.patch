+    // The process policy is immutable for its lifetime. Non-OTG workers must
+    // never run network recovery or configfs cleanup, including through APIs.
+    fn owns_otg(&self) -> Result<bool> {
+        match std::env::var("ONE_KVM_OTG_OWNERSHIP").as_deref() {
+            Ok("none") => return Ok(false),
+            Ok("owner") | Err(std::env::VarError::NotPresent) => {},
+            _ => return Err(AppError::Config("Invalid OTG ownership policy".into())),
+        }
+        let mut guard = self.ownership_lock.lock()
+            .map_err(|_| AppError::Config("OTG ownership lock poisoned".into()))?;
+        if guard.is_none() {
+            let file = std::fs::OpenOptions::new().create(true).truncate(false)
+                .write(true).open("/run/lock/one-kvm-otg.lock")
+                .map_err(|_| AppError::Config("Cannot open OTG ownership lock".into()))?;
+            file.try_lock().map_err(|_| AppError::Config("OTG belongs to another process".into()))?;
+            *guard = Some(file);
+        }
+        Ok(true)
     }
 
