@@ -38,6 +38,25 @@ pub use video_codec::{
 pub use vp8::{VP8Config, VP8Encoder, VP8EncoderType, VP8InputFormat};
 pub use vp9::{VP9Config, VP9Encoder, VP9EncoderType, VP9InputFormat};
 
+/// Whether the named encoder must be given planar YUV420P instead of a
+/// semi-planar NV12/NV21 buffer to produce correct colours.
+///
+/// The Raspberry Pi 4B bcm2835 `h264_v4l2m2m` encoder advertises NV12 and
+/// NV21 support but writes corrupted chroma for both. Planar YU12 is correct.
+/// The check is limited to Raspberry Pi device trees so other v4l2m2m
+/// platforms keep their existing zero-copy semi-planar path.
+pub(crate) fn requires_planar_input(codec_name: &str) -> bool {
+    if !codec_name.contains("v4l2m2m") {
+        return false;
+    }
+    static IS_RASPBERRY_PI: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *IS_RASPBERRY_PI.get_or_init(|| {
+        std::fs::read_to_string("/proc/device-tree/model")
+            .map(|model| model.contains("Raspberry Pi"))
+            .unwrap_or(false)
+    })
+}
