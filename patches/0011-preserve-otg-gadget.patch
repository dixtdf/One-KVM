+    /// Check that an already-bound ConfigFS gadget is safe to adopt. This avoids
+    /// recreating a healthy device, which would cause the USB host to disconnect
+    /// and assign a new device number to the running virtual machine.
+    fn existing_gadget_matches(&self) -> Result<bool> {
+        let descriptor_matches = [
+            ("idVendor", format!("0x{:04x}", self.descriptor.vendor_id)),
+            ("idProduct", format!("0x{:04x}", self.descriptor.product_id)),
+            ("bcdDevice", format!("0x{:04x}", self.descriptor.device_version)),
+        ]
+        .into_iter()
+        .all(|(attribute, expected)| {
+            read_attribute(&self.gadget_path.join(attribute)) == expected
+        });
+        if !descriptor_matches {
+            return Ok(false);
+        }
+
+        let strings_path = self.gadget_path.join("strings/0x409");
+        let strings_match = [
+            ("serialnumber", self.descriptor.serial_number.as_str()),
+            ("manufacturer", self.descriptor.manufacturer.as_str()),
+            ("product", self.descriptor.product.as_str()),
+        ]
+        .into_iter()
+        .all(|(attribute, expected)| {
+            read_attribute(&strings_path.join(attribute)) == expected
+        });
+        if !strings_match {
+            return Ok(false);
+        }
+
+        for func in &self.functions {
+            if !self.gadget_path.join("functions").join(func.name()).is_dir() {
+                return Ok(false);
+            }
+            if self.config_path.join(func.name()).symlink_metadata().is_err() {
+                return Ok(false);
+            }
+        }
+
+        match self.expected_udc.as_deref() {
+            Some(expected) => self.current_udc().as_deref() == Some(expected),
+            None => true,
+        }
+    }
