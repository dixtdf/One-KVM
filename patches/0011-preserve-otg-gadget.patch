+    fn prepare_matching_gadget(manager: &mut OtgGadgetManager) -> tempfile::TempDir {
+        let temp = tempfile::tempdir().unwrap();
+        let base = temp.path();
+        manager.gadget_path = base.join("one-kvm");
+        manager.config_path = manager.gadget_path.join("configs/c.1");
+        fs::create_dir_all(manager.gadget_path.join("functions/hid.usb0")).unwrap();
+        fs::create_dir_all(manager.config_path).unwrap();
+        fs::write(manager.gadget_path.join("idVendor"), "0x1d6b
+").unwrap();
+        fs::write(manager.gadget_path.join("idProduct"), "0x0104
+").unwrap();
+        fs::write(manager.gadget_path.join("bcdDevice"), "0x0100
+").unwrap();
+        fs::create_dir_all(manager.gadget_path.join("strings/0x409")).unwrap();
+        fs::write(manager.gadget_path.join("strings/0x409/serialnumber"), "0123456789
+").unwrap();
+        fs::write(manager.gadget_path.join("strings/0x409/manufacturer"), "One-KVM
+").unwrap();
+        fs::write(manager.gadget_path.join("strings/0x409/product"), "One-KVM USB Device
+").unwrap();
+        manager.add_keyboard(false).unwrap();
+        std::os::unix::fs::symlink(
+            manager.gadget_path.join("functions/hid.usb0"),
+            manager.config_path.join("hid.usb0"),
+        )
+        .unwrap();
+        fs::write(manager.gadget_path.join("UDC"), "test-udc
+").unwrap();
+        temp
+    }
