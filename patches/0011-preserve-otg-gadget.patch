+        manager.preserve_existing();
+        let _keep = prepare_matching_gadget(&mut manager);
+        fs::write(manager.gadget_path.join("idProduct"), "0x9999
+").unwrap();
+
+        assert!(!manager.existing_gadget_matches().unwrap());
+    }
+
+    #[test]
+    fn missing_function_is_detected() {
+        let mut manager = OtgGadgetManager::new();
+        manager.preserve_existing();
+        let _keep = prepare_matching_gadget(&mut manager);
+        fs::remove_dir(manager.gadget_path.join("functions/hid.usb0")).unwrap();
+
+        assert!(!manager.existing_gadget_matches().unwrap());
+    }
+
+    #[test]
+    fn relinquish_keeps_gadget_and_udc_bound() {
+        let mut manager = OtgGadgetManager::new();
+        manager.preserve_existing();
+        let _keep = prepare_matching_gadget(&mut manager);
+
+        manager.preserve_existing_udc("test-udc");
+        manager.bind("test-udc").unwrap();
+        manager.relinquish();
+        manager.bind("test-udc").unwrap();
+
+        assert!(!manager.created_by_us);
+        assert_eq!(
+            fs::read_to_string(manager.gadget_path.join("UDC")).unwrap().trim(),
+            "test-udc"
+        );
+    }
