+/// Restricted worker input adapter. Existing authenticated /api middleware
+/// remains mandatory; only the manager knows the random internal credentials.
+pub async fn platform_input(
+    State(state): State<Arc<AppState>>,
+    axum::Json(data): axum::Json<Vec<u8>>,
+) -> (axum::http::StatusCode, axum::Json<serde_json::Value>) {
+    use axum::http::StatusCode;
+    if std::env::var("ONE_KVM_PLATFORM_WORKER").as_deref() != Ok("1") {
+        return (StatusCode::NOT_FOUND, axum::Json(serde_json::json!({"error":"Unavailable"})));
+    }
+    if data.len() > 7 {
+        return (StatusCode::BAD_REQUEST, axum::Json(serde_json::json!({"error":"Invalid input"})));
+    }
+    let result = if data.is_empty() {
+        state.hid.reset_confirmed().await.map_err(|_| "Cannot reset input".to_string())
+    } else { handle_binary_message(&data, &state).await };
+    match result {
+        Ok(()) => (StatusCode::OK, axum::Json(serde_json::json!({"accepted":true}))),
+        Err(_) => (StatusCode::BAD_REQUEST, axum::Json(serde_json::json!({"error":"Input rejected"}))),
+    }
+}
