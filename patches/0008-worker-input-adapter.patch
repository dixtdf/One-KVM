+    /// Confirm backend reset execution, rather than just accepting a queue item.
+    pub async fn reset_confirmed(&self) -> Result<()> {
+        if !self.backend_available.load(Ordering::Acquire) {
+            return Err(AppError::BadRequest("HID backend is unavailable".into()));
+        }
+        let (tx, rx) = tokio::sync::oneshot::channel();
+        self.enqueue_event(QueuedHidEvent::ResetConfirmed(tx)).await?;
+        match tokio::time::timeout(std::time::Duration::from_secs(3), rx).await {
+            Ok(Ok(true)) => Ok(()),
+            _ => Err(AppError::BadRequest("HID reset was not confirmed".into())),
+        }
+    }
+
     pub async fn is_available(&self) -> bool {
